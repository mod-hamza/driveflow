<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name ="name"/>
                <field name ="expected_price"/>
                <field name ="living_area"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="sell_property" type="object" string="Sell" invisible="state in ('sold', 'cancelled')"/>
                    <button name="cancel_property" type="object" string="Cancel" invisible="state in ('sold', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_accepted,sold" invisible="state == 'cancelled'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancelled'"/>
                </header>
                <sheet>
                    <h1>
                        <field name ="name"/>
                    </h1>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <group>DD
                        <field name ="property_type_id"/>
                        <field name ="date_availability"/>
                        <field name ="expected_price"/>
                        <field name ="selling_price"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name ="description"/>
                                <field name ="bedrooms"/>
                                <field name ="living_area"/>
                                <field name ="has_garden"/>
                                <field name ="garden_area" invisible="not has_garden"/>
                                <field name ="total_area"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="buyer_id"/>
                                <field name="salesperson_id"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ('sold', 'cancelled', 'offer_accepted')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <templates default_group="property_type_id">
                    <field name="selling_price"/>
                    <field name="state"/>
                    <t t-name="card">
                        <field name="name"/>
                        <field name="expected_price"/>
                        <field name="state"/>
                        <t t-if="record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold'">
                            <div>
                                <span> Selling Price</span>
                                <field name="selling_price"/>
                            </div>
                        </t>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
