<odoo>
    <record id="driveflow_extra_charges_action" model="ir.actions.act_window">
        <field name="name">Extra Charges</field>
        <field name="res_model">driveflow.extra.charges</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('agreement_id', '=', active_id)]</field>
    </record>

   <record id="driveflow_extra_charges_view_list" model="ir.ui.view">
        <field name="name">driveflow.extra.charges.list</field>
        <field name="model">driveflow.extra.charges</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="description"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="driveflow_extra_charges_view_form" model="ir.ui.view">
        <field name="name">driveflow.extra.charges.form</field>
        <field name="model">driveflow.extra.charges</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
