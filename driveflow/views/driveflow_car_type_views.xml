<odoo>
    <record id="driveflow_car_type_action" model="ir.actions.act_window">
        <field name="name">Car types</field>
        <field name="res_model">driveflow.car.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="driveflow_car_type_view_form" model="ir.ui.view">
        <field name="name">driveflow.car.type.form</field>
        <field name="model">driveflow.car.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                </sheet>
            </form>
        </field>
    </record>

    <record id="driveflow_car_type_view_list" model="ir.ui.view">
        <field name="name">driveflow.car.type.list</field>
        <field name="model">driveflow.car.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

</odoo>
