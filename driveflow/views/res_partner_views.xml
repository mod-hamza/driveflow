<odoo>
    <record id="res_partner_view_form_inherit_driveflow" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.driveflow</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Car Agreements">
                    <field name="agreement_ids">
                        <list>
                            <field name="customer_id"/>
                            <field name="driver_license"/>
                            <field name ="car_id"/>
                            <field name ="date_start"/>
                            <field name ="date_end"/>
                            <field name ="duration"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
