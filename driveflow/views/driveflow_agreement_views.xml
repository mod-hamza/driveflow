<odoo>
    <record id="driveflow_agreement_action" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">driveflow.agreement</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="driveflow_agreement_view_list" model="ir.ui.view">
        <field name="name">driveflow.agreement.list</field>
        <field name="model">driveflow.agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name ="customer_id"/>
                <field name ="car_id"/>
                <field name ="date_start"/>
            </list>
        </field>
    </record>

    <record id="driveflow_agreement_view_form" model="ir.ui.view">
        <field name="name">driveflow.agreement.form</field>
        <field name="model">driveflow.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,returned,invoiced" />
                </header>
                <sheet>
                    <h1>
                        <!--<field name ="name"/>-->
                        <field name = "customer_id" string = "Customer Name" />
                    </h1>
                    <group>
                        <field name ="driver_license" readonly="state != 'draft'" string="Driver License Number"/>
                        <field name ="car_id" readonly="state != 'draft'" string="Car"/>
                        <field name ="date_start" readonly="state != 'draft'" string="Start Date"/>
                        <field name ="date_end" readonly="state != 'draft'" string="End Date"/>
                        <field name = "duration"/>
                    </group>
                    <notebook>
                        <page string="Extra Charges" invisible = "state != 'returned'">
                            <field name="extra_charge_ids"/>
                        </page>
                    </notebook>
                    <button name = "action_hand_over" type = "object" string = "Hand Over" invisible = "state != 'draft'" /> <!-- add car status-->
                    <button name = "action_return_car" type = "object" string = "Return Car" invisible = "state != 'ongoing'" />
                    <button name = "action_generate_invoice" type = "object" string = "Generate Invoice" invisible = "state != 'returned'" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="driveflow_agreement_view_kanban" model="ir.ui.view">
        <field name="name">driveflow.agreement.kanban</field>
        <field name="model">driveflow.agreement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="customer_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name = "customer_id"/>
                        <field name="car_id"/>
                        <field name="date_start"/>
                        <field name="state"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
